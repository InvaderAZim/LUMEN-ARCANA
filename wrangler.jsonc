{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumen-arcana-v2",
  "main": "worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "vars": {
    "BETA_CODES": "LUMEN-BETA",
    "OPENAI_MODEL": "gpt-5.6-luna"
  }
}
